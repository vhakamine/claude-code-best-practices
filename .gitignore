# PyInstaller
#  Usually these files are written by a python script from a pyinstaller executable
#  so that python does not see a .pyc file.
#  The executable tries to rebuild .pyc ext in the same directory as the executable.
#  so two files.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

